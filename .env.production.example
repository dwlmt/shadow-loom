# =====================================================================
# Shadow-Loom — production environment template (Railway / Fly / etc.)
# =====================================================================
# Copy the keys from this file into Railway's "Variables" tab.
# DO NOT commit a filled-in copy — every value here is a secret in
# production.
#
# DATABASE_URL and PORT are injected automatically by Railway when you
# attach a Postgres service and deploy the web service. The list below
# is what you must set yourself.

# ── Cookie / session signing (required) ──────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=

# ── Public URL (required for OAuth) ──────────────────────────────
# Set this to your Railway public domain WITHOUT a trailing slash, e.g.
#   https://shadow-loom-production.up.railway.app
# Or your custom domain. Used to build OAuth callback URLs.
OAUTH_REDIRECT_BASE=

# ── OAuth providers ──────────────────────────────────────────────
# Set at least one provider. Every provider's callback URL takes the form:
#   ${OAUTH_REDIRECT_BASE}/auth/<provider>/callback
# Configure that exact URL in each provider's developer console.

# GitHub:  https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google:  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Microsoft: https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Sign in with Apple (OIDC) — https://developer.apple.com/account/resources
#   1. Create a Services ID (e.g. com.example.shadow-loom.web) and put it
#      in APPLE_CLIENT_ID. The redirect URL must exactly match
#      ${OAUTH_REDIRECT_BASE}/auth/apple/callback.
#   2. Either pre-generate the ES256 JWT client_secret yourself and set
#      APPLE_CLIENT_SECRET, OR set the three signing variables below and
#      Shadow-Loom will mint and rotate the JWT for you. The Apple JWT
#      can have at most a 6-month expiry; auto-mint refreshes hourly.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full PEM contents of the .p8 file you downloaded from
# Apple Developer (including BEGIN/END lines, with literal \n line
# breaks if your secret store strips newlines).
APPLE_PRIVATE_KEY=

# ── LLM provider — OpenRouter ────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pick an OpenRouter model. Format: openrouter:<provider>/<model>
# See https://openrouter.ai/models for the catalogue. The default below
# is Qwen3.6-35B-A3B (sparse-MoE, 35B total / 3B active, Apache 2.0,
# 262K native context, $0.15/M in, $1/M out) — the same model used in
# local development against Ollama, so prompts are tuned for it.
#
# Setting DEFAULT_MODEL is enough — every pipeline stage inherits it.
# Override individual stages only when you want them to differ:
#   GENERATION_MODEL=openrouter:anthropic/claude-3.5-sonnet
#   QUERY_PARSING_MODEL=openrouter:anthropic/claude-3.5-haiku
#   AUDITOR_MODEL=openrouter:anthropic/claude-3.5-sonnet
#   AUDITOR_GENERATION_MODEL=openrouter:anthropic/claude-3.5-sonnet
#   EXTRACTION_MODEL=openrouter:google/gemini-2.5-pro
DEFAULT_MODEL=openrouter:qwen/qwen3.6-35b-a3b

# Cap output tokens to something the chosen models actually support.
# Qwen3.6-35B-A3B can emit up to its full 262K window; the values below
# leave plenty of headroom for prose generation while keeping audit /
# query-parsing JSON responses bounded. Trim if you switch to a
# short-output model: Claude 3.5 Sonnet caps at 8K, GPT-4o at 16K.
GENERATION_MAX_TOKENS=64000
QUERY_PARSING_MAX_TOKENS=16000
AUDITOR_MAX_TOKENS=16000
AUDITOR_MAX_TOKENS_GENERATION=64000

# ── Optional: Langfuse tracing ───────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Pipeline / MCP — production defaults ─────────────────────────
PIPELINE_SKIP_AUDIT=false
PIPELINE_SKIP_REEXTRACTION=false
MCP_SKIP_AUDIT=true
# Production MUST keep this false — it's a "trust everyone" toggle for dev.
MCP_ALLOW_OPEN_MODE=false

# ── UI ───────────────────────────────────────────────────────────
# UI_HOST and UI_PORT are set by the Dockerfile / Railway $PORT.
# UI_RELOAD must stay false in production.
UI_TITLE=Shadow Loom
UI_DARK_MODE=false
UI_RELOAD=false
