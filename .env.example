# =====================================================================
# Shadow Loom — local environment template
# =====================================================================
# Copy to ".env" in the repo root and edit the values you need:
#
#     cp .env.example .env
#
# Every variable is OPTIONAL. Sensible defaults live in
# "shadow_loom/settings.py"; this file lists the knobs most users
# touch first. For the full reference see "docs/settings.md".
#
# Order of precedence (highest first):
#   1. Real environment variables (export FOO=bar)
#   2. .env  (this file once copied)
#   3. config.env  (legacy fallback, also git-ignored)
#   4. Built-in defaults in shadow_loom/settings.py
#
# Never commit ".env" — it's already covered by .gitignore.
# =====================================================================

# ── Database ──────────────────────────────────────────────────────
# SQLite is fine for local dev. For Postgres use:
#   postgresql+psycopg://user:pass@host:5432/shadow_loom
DATABASE_URL=sqlite:///shadow_loom.db

# ── LLM provider ──────────────────────────────────────────────────
# Model strings use a "<provider>:<model>" prefix. Built-in providers:
#   ollama:<model>      → local Ollama (default; needs `ollama serve`)
#   openrouter:<model>  → OpenRouter         (set OPENROUTER_API_KEY)
#   openai:<model>      → OpenAI direct      (set OPENAI_API_KEY)
#   fireworks:<model>   → Fireworks AI       (set FIREWORKS_API_KEY)
#   featherless:<model> → Featherless        (set FEATHERLESS_API_KEY)
#   together:<model>    → Together AI        (set TOGETHER_API_KEY)
#   deepinfra:<model>   → DeepInfra          (set DEEPINFRA_API_KEY)
#   groq:<model>        → Groq               (set GROQ_API_KEY)
#   anyscale:<model>    → Anyscale Endpoints (set ANYSCALE_API_KEY)
#   perplexity:<model>  → Perplexity         (set PERPLEXITY_API_KEY)
#   huggingface:<model> → Hugging Face       (set HUGGINGFACE_API_KEY)
#
# All non-Ollama providers above share the OpenAI-compatible Chat Completions
# wire format. Override the default base URL with <PREFIX>_BASE_URL (e.g.
# FIREWORKS_BASE_URL=https://my-proxy/v1).
#
# Cost tracking: All API calls are automatically tracked for cost calculation.
# Token usage and estimated costs are logged to the database and can be
# viewed through the cost CLI or queried via the MCP cost tools.
#
# To plug in any other OpenAI-compatible endpoint without code changes:
#   SHADOW_LOOM_PROVIDERS=mistral=https://api.mistral.ai/v1,xai=https://api.x.ai/v1
#   MISTRAL_API_KEY=...
#   DEFAULT_MODEL=mistral:mistral-large-latest
#
# Quick OpenRouter swap (uncomment + set key):
#   DEFAULT_MODEL=openrouter:google/gemini-2.0-flash-001
#   GENERATION_MODEL=openrouter:google/gemini-2.0-flash-001
#   AUDITOR_MODEL=openrouter:google/gemini-2.0-flash-001
#   EXTRACTION_MODEL=openrouter:google/gemini-2.0-flash-001
#   QUERY_PARSING_MODEL=openrouter:google/gemini-2.0-flash-001
DEFAULT_MODEL=ollama:qwen3.6:27b
OLLAMA_BASE_URL=http://localhost:11434/v1/

# Provider API keys (only the ones you actually use need a value)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
FEATHERLESS_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=
ANYSCALE_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=

# Tavily API key for research functionality
TAVILY_API_KEY=

# Optional: register extra OpenAI-compatible providers
# SHADOW_LOOM_PROVIDERS=

# ── Per-stage models (override DEFAULT_MODEL when set) ───────────
GENERATION_MODEL=ollama:qwen3.6:27b
EXTRACTION_MODEL=ollama:qwen3.6:27b
AUDITOR_MODEL=ollama:qwen3.6:27b
AUDITOR_GENERATION_MODEL=ollama:qwen3.6:27b
QUERY_PARSING_MODEL=ollama:qwen3.6:27b

# ── Generation tuning ─────────────────────────────────────────────
GENERATION_MAX_TOKENS=64000
GENERATION_TEMPERATURE=0.7
GENERATION_OUTPUT_RETRIES=5

# ── Auditor tuning ────────────────────────────────────────────────
AUDITOR_MAX_ITERATIONS=3
AUDITOR_OUTPUT_RETRIES=5
AUDITOR_TEMPERATURE=0.2
AUDITOR_GENERATION_TEMPERATURE=0.7
AUDITOR_MAX_TOKENS=64000
AUDITOR_MAX_TOKENS_GENERATION=64000
AUDITOR_MIN_FORESHADOWING_SCORE=0.6
AUDITOR_MAX_AFFECTIVE_LOSS=0.3
AUDITOR_MIN_COGNITIVE_PLAUSIBILITY=0.7
AUDITOR_MAX_MIRACLE_STEPS=0
AUDITOR_IGNORE_SPATIAL_BLOCKS=false

# ── Ingestion tuning ──────────────────────────────────────────────
EXTRACTION_CHUNK_STRATEGY=act_headings
EXTRACTION_OUTPUT_RETRIES=5
EXTRACTION_FABULA_TIME_SPACING=1000
EXTRACTION_MIN_CHUNK_CHARS=1500
EXTRACTION_CHUNK_OVERLAP_CHARS=300
EXTRACTION_MAX_CORRECTION_RETRIES=5
EXTRACTION_MAX_CONCURRENT_CHUNKS=8
EXTRACTION_ESTIMATED_EVENTS_PER_CHUNK=10

# ── Pipeline ──────────────────────────────────────────────────────
PIPELINE_USE_CAUSAL_ENGINE=true
PIPELINE_SKIP_AUDIT=false
PIPELINE_SKIP_REEXTRACTION=false
PIPELINE_MAX_SNAPSHOTS=10

# ── Causal physics constants ──────────────────────────────────────
PHYSICS_STRENGTH_WEAK=0.25
PHYSICS_STRENGTH_MODERATE=0.5
PHYSICS_STRENGTH_STRONG=0.75
PHYSICS_MECHANISM_FALLBACK_FACTOR=0.2
PHYSICS_DEFAULT_TRAIT_BASELINE=0.5
PHYSICS_DEFAULT_CAUSAL_FORCE=5.0
PHYSICS_CAUSAL_FORCE_SCALING=10.0
PHYSICS_RELATIONSHIP_INERTIA_DEFAULT=0.3
PHYSICS_AMBIENT_FORCE_MULTIPLIER=2.0
PHYSICS_INERTIA_EPSILON=0.0
PHYSICS_EGO_MEMORY_LIMIT=5

# ── MCP server ────────────────────────────────────────────────────
MCP_SKIP_AUDIT=true
MCP_INGEST_FABULA_TIME_SPACING=1000
MCP_INGEST_MAX_CORRECTION_RETRIES=5
MCP_ALLOW_OPEN_MODE=false

# ── UI server ─────────────────────────────────────────────────────
UI_HOST=0.0.0.0
UI_PORT=7860
UI_TITLE=Shadow Loom
UI_DARK_MODE=false
UI_RELOAD=false
# AGPL § 13: hosted instances must offer their corresponding source.
# Override this if you run a modified build.
UI_SOURCE_URL=https://github.com/dwlmt/shadow-loom

# ── UI auth / OAuth (leave blank to disable auth entirely) ───────
# When all *_CLIENT_ID values are blank, Shadow Loom runs as a
# single-user local app with a built-in "Local User" account.
STORAGE_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:7860
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Observability (optional) ──────────────────────────────────────
# Sign up at https://langfuse.com and create a project to get keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Cost tracking (automatically calculated from usage) ───────────
# Cost calculations run automatically when agents execute. See logs/
# directory for detailed cost breakdowns by user and project.
# Default cost rules are built-in for common providers. Custom rules
# can be added via the database or MCP tools.
