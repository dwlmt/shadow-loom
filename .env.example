# Shadow Loom UI — Environment Variables
# Copy to .env and fill in values

# Database (SQLite default, PostgreSQL for production)
DATABASE_URL=sqlite:///shadow_loom.db

# NiceGUI session encryption key
STORAGE_SECRET=change-me-to-a-random-string

# OAuth (optional — app works without auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:7860

# Ollama LLM backend
OLLAMA_BASE_URL=http://localhost:11434/v1/
DEFAULT_MODEL=ollama:qwen3.6:27b
